{
  "expo": {
    "name": "TypeGPU Kit",
    "slug": "typegpu-kit-native",
    "version": "0.0.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0d12",
    "scheme": "typegpukit",
    "platforms": ["ios"],
    "ios": {
      "bundleIdentifier": "com.swmansion.typegpukit",
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "plugins": [
      "expo-router",
      "react-native-webgpu",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a photo for an example, such as the image a domino run lays out.",
          "cameraPermission": "Show your camera in examples that read it, such as the ember mirror.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
