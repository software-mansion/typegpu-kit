---
import { Code } from 'astro:components';
import type { ComponentProps } from 'astro/types';
import '../../styles/tokens.css';
import '../../styles/viz.css';
import ExampleFigure from '../../components/viz/ExampleFigure.astro';
import { BASE, exampleHref, markdownHref, pageHref, sourceHref } from '../../components/site/urls.ts';
import { loadModules } from '../../components/site/load.ts';
import Meta from '../../components/site/Meta.astro';
import { examples, type Example } from '../../examples/examples.ts';
import type { Shown } from '../../source/client.ts';
import { read, type SourceFile } from '../../source/read.ts';
import { instrument } from '../../styles/instrument.mjs';

export function getStaticPaths() {
  return examples.map((example) => ({
    params: { name: example.key },
    props: { example },
  }));
}

const { example } = Astro.props as { example: Example };
const source = read(example.key);
const modules = (await loadModules()).filter((module) => module.package === '@typegpu/kit');
const kit = source.kit.flatMap((namespace) => {
  const module = modules.find((each) => each.namespace === namespace);
  return module ? [module] : [];
});

/** Each name with, for the kit, its module's summary and docs page. */
const traced = Object.fromEntries(
  Object.entries(source.traced).map(([id, entry]): [string, Shown] => {
    const module =
      entry.kind === 'module'
        ? modules.find((each) => each.namespace === entry.name)
        : entry.kind === 'api' && entry.file
          ? modules.find((each) => each.file === entry.file)
          : undefined;
    if (!module) return [id, entry];
    return [
      id,
      {
        ...entry,
        module: {
          name: module.namespace,
          summary: module.summary,
          ...(module.page ? { href: pageHref(module.page) } : {}),
        },
      },
    ];
  }),
);

type Transformer = NonNullable<ComponentProps<typeof Code>['transformers']>[number];

/** Gives each line an id and its GPU range, and marks the names to trace. */
const lines = (file: SourceFile, marks = new Map(file.marks)): Transformer => ({
  // Shiki merges spaces into the next token; a name's mark should cover the name alone
  tokens(tokens) {
    return tokens.map((line) =>
      line.flatMap((token) => {
        const [, before = '', core = '', after = ''] = /^(\s*)(.*?)(\s*)$/s.exec(token.content)!;
        const offset = token.offset + before.length;
        if ((!before && !after) || !marks.has(offset)) return [token];
        return [
          ...(before ? [{ ...token, content: before }] : []),
          { ...token, content: core, offset },
          ...(after ? [{ ...token, content: after, offset: offset + core.length }] : []),
        ];
      }),
    );
  },
  code(node) {
    // Lines are blocks, so the newlines between them would add empty lines
    node.children = node.children.filter((child) => child.type !== 'text');
  },
  line(node, line) {
    node.properties.id = `${file.name}:${line}`;
    const index = file.gpu.findIndex(([from, to]) => line >= from && line <= to);
    if (index < 0) return;
    const [from, to] = file.gpu[index];
    this.addClassToHast(node, ['g', ...(line === from ? ['g0'] : []), ...(line === to ? ['g1'] : [])]);
  },
  span(node, _line, _col, _element, token) {
    const id = marks.get(token.offset);
    if (id) node.properties['data-n'] = id;
  },
});

// In a script element, so `<` is escaped
const profile = `${exampleHref(example.key)}?debug`;
const data = JSON.stringify({ profile, traced }).replaceAll('<', '\\u003c');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />
    <title>{example.title} source · TypeGPU Kit</title>
    <Meta
      title={`${example.title} source · TypeGPU Kit`}
      description={`The source of ${example.title}, file by file. ${example.description}`}
      canonical={sourceHref(example.key)}
      markdown={markdownHref(`examples/${example.key}`)}
    />
  </head>
  <body>
    <nav class="bar" aria-label="Source">
      <a href={exampleHref()}><span aria-hidden="true">←</span> Examples</a>
      <span class="title">{example.title}</span>
      <a href={exampleHref(example.key)}>Run full screen</a>
      <a href={profile}>Profile</a>
      <span class="key">runs on the GPU</span>
    </nav>

    <div class="tour">
      <main class="code" id="code">
        <header class="overview">
          <h1>{example.title}</h1>
          <p class="description">{example.description}</p>
          <h4>Files, in reading order</h4>
          <ol class="toc">
            {
              source.files.map((file) => (
                <li>
                  <a href={`#${file.name}`}>{file.name}</a>
                  <span>
                    {file.summary
                      .split('`')
                      .map((part, i) => (i % 2 === 1 ? <code>{part}</code> : part))}
                  </span>
                </li>
              ))
            }
          </ol>
          <p class="also">
            Kit modules{' '}
            {
              kit.map((module, i) => (
                <>
                  {i > 0 && ', '}
                  {module.page ? (
                    <a href={pageHref(module.page)} title={module.summary}>
                      {module.namespace}
                    </a>
                  ) : (
                    <span title={module.summary}>{module.namespace}</span>
                  )}
                </>
              ))
            }
            {source.packages.length > 0 && `. Also ${source.packages.join(', ')}`}.
          </p>
        </header>
        {
          source.files.map((file) => (
            <section class="file" id={file.name} style={`--lines: ${file.code.replace(/\n$/, '').split('\n').length}`}>
              <h2>
                <span>{file.name}</span>
                <button class="copy" type="button" data-file={file.name}>
                  Copy
                </button>
              </h2>
              <Code code={file.code} lang="ts" theme={instrument} transformers={[lines(file)]} />
            </section>
          ))
        }
      </main>

      <aside class="side">
        <ExampleFigure example={example.key} />
        <div class="panel">
          <p class="hint" id="hint">
            Hover a name to mark it everywhere it appears. Click it to read its docs and list its
            uses. In a focused file, arrow keys step through names and Enter opens one.
          </p>
          <section class="card" id="card"></section>
        </div>
      </aside>
    </div>

    <script type="application/json" id="source" set:html={data} />
    <script>
      import { start } from '../../source/client.ts';
      start();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bar: 36px;
    --line: 20px;
    --lane: 28px;
    --code-size: 13px;
    --gpu: var(--mark-lilac);
    --mark: var(--accent);
  }

  /* Taps mark names, so a second one shouldn't zoom */
  html {
    touch-action: manipulation;
  }

  html,
  body {
    margin: 0;
    background: var(--ground);
    color: var(--text-2);
    font: 12px/1.4 var(--font-mono);
  }

  a {
    color: var(--link);
    text-decoration: none;
  }

  @media (hover: hover) {
    a:hover {
      color: var(--accent-high);
    }
  }

  /* Small labels over lists and groups */
  .overview h4,
  .card h4 {
    margin: 0 0 var(--s-2);
    color: var(--muted);
    font: 400 11px/1.4 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Small outlined buttons */
  .copy {
    flex: none;
    padding: 0 6px;
    border: 1px solid var(--rule);
    background: none;
    color: var(--muted);
    font: 11px/1.5 var(--font-mono);
    cursor: pointer;
  }

  @media (hover: hover) {
    .copy:hover {
      color: var(--text);
    }

    [data-n]:hover {
      background: hsl(220 20% 18%);
    }
  }

  .bar {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    gap: var(--s-4);
    align-items: center;
    box-sizing: border-box;
    height: var(--bar);
    padding: 0 var(--s-4);
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    background: var(--ground);
    white-space: nowrap;
  }

  .bar a {
    color: var(--text-2);
  }

  .bar .title {
    color: var(--text);
  }

  .bar .key {
    margin-left: auto;
    color: var(--muted);
  }

  .bar .key::before {
    content: '';
    display: inline-block;
    width: 2px;
    height: 10px;
    margin-right: 8px;
    background: var(--gpu);
  }

  .tour {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 34vw);
  }

  .code {
    min-width: 0;
    padding-bottom: 50vh;
  }

  .overview {
    padding: var(--s-6) var(--s-5) var(--s-5) var(--lane);
    border-bottom: 1px solid var(--rule);
  }

  .overview h1 {
    margin: 0 0 var(--s-2);
    color: var(--text);
    font: 500 22px/1.2 var(--font-sans);
  }

  .overview .description {
    max-width: 70ch;
    margin: 0 0 var(--s-5);
    font: 15px/1.5 var(--font-sans);
  }

  .overview ol {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .overview li {
    display: grid;
    grid-template-columns: 12ch 1fr;
    gap: var(--s-3);
    font: 13px/1.45 var(--font-sans);
  }

  .overview li > a {
    font: 12px/1.6 var(--font-mono);
  }

  .overview li code {
    color: var(--text);
    font: 12px var(--font-mono);
  }

  .overview .also {
    max-width: 90ch;
    margin: var(--s-4) 0 0;
    color: var(--muted);
    font: 12px/1.6 var(--font-sans);
  }

  .overview .also :is(a, span) {
    color: var(--text-2);
    font-family: var(--font-mono);
  }

  .file h2 {
    position: sticky;
    top: var(--bar);
    z-index: 1;
    display: flex;
    gap: var(--s-4);
    margin: 0;
    padding: var(--s-2) var(--s-4) var(--s-2) var(--lane);
    border-block: 1px solid var(--rule);
    background: var(--ground-2);
    color: var(--text);
    font: 500 12px/1.4 var(--font-mono);
  }

  .file h2 .copy {
    margin-left: auto;
  }

  /* Files off screen skip rendering, holding their exact height so scrolling never jumps */
  .file pre {
    content-visibility: auto;
    contain-intrinsic-block-size: auto calc(var(--lines) * var(--line) + var(--s-3) + var(--s-6));
    margin: 0;
    padding: var(--s-3) 0 var(--s-6);
    background: none !important;
    font: var(--code-size) / var(--line) var(--font-mono);
  }

  .file code {
    counter-reset: line;
  }

  .file .line {
    display: block;
    position: relative;
    min-height: var(--line);
    padding-left: calc(var(--lane) + 6ch);
    scroll-margin-top: calc(var(--bar) + 40px);
  }

  .file .line::before {
    counter-increment: line;
    content: counter(line);
    position: absolute;
    left: var(--lane);
    width: 4ch;
    color: hsl(214 10% 32%);
    text-align: right;
    user-select: none;
  }

  /* GPU code: a band at the left, and a faint wash */
  .file .line.g {
    background: linear-gradient(90deg, color-mix(in oklab, var(--gpu) 7%, transparent), transparent 70%);
  }

  .file .line.g::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--lane) - 10px);
    width: 2px;
    background: var(--gpu);
    opacity: 0.55;
  }

  .file .line.g0::after {
    top: 4px;
  }

  .file .line.g1::after {
    bottom: 4px;
  }

  .file .line.used::before {
    color: var(--accent-high);
  }

  .file .line.flash {
    animation: flash 1.2s ease-out;
  }

  @keyframes flash {
    from {
      background-color: color-mix(in oklab, var(--accent) 28%, transparent);
    }
  }

  [data-n] {
    border-radius: 2px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .file pre:focus-visible,
  [data-n]:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: -1px;
  }

  [data-n].use {
    background: color-mix(in oklab, var(--accent) 14%, transparent);
  }

  [data-n].def {
    background: color-mix(in oklab, var(--accent) 26%, transparent);
  }

  .beyond {
    position: fixed;
    z-index: 2;
    padding: 2px 8px;
    border: 1px solid color-mix(in oklab, var(--accent) 50%, transparent);
    border-radius: 10px;
    background: var(--ground-2);
    color: var(--accent-high);
    font: 11px/1.4 var(--font-mono);
    cursor: pointer;
  }

  .side {
    position: sticky;
    top: var(--bar);
    align-self: start;
    display: flex;
    flex-direction: column;
    height: calc(100vh - var(--bar));
    border-left: 1px solid var(--rule);
  }

  /* The figure fills the column's top, edge to edge */
  .side > .viz {
    flex: none;
    margin: 0;
    padding: var(--s-3) 0 var(--s-2);
    border-top: 0;
  }

  .side > .viz :is(.heading, .viz-controls) {
    padding-inline: var(--s-4);
  }

  .panel {
    flex: 1;
    overflow-y: auto;
  }

  .hint,
  .card {
    padding: var(--s-4);
  }

  .hint,
  .card {
    border-bottom: 1px solid var(--rule);
  }

  .hint {
    margin: 0;
    color: var(--muted);
    font: 13px/1.5 var(--font-sans);
  }

  .card:not(.open) {
    display: none;
  }

  /* Beside the code the card takes the hint's place; above it the hint stays, so nothing moves */
  @media (min-width: 901px) {
    .panel:has(.card.open) .hint {
      display: none;
    }
  }

  .card h3 {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    align-items: baseline;
    margin: 0 0 var(--s-2);
    color: var(--text);
    font: 500 14px/1.3 var(--font-mono);
  }

  .card h3 a {
    color: var(--muted);
    font-size: 11px;
    font-weight: 400;
  }

  .card h3 .tag {
    padding: 0 6px;
    border: 1px solid var(--rule-strong);
    color: var(--muted);
    font-size: 11px;
    font-weight: 400;
  }

  .card h3 .tag.gpu {
    border-color: color-mix(in oklab, var(--gpu) 50%, transparent);
    color: var(--gpu);
  }

  .card h3 button {
    margin-left: auto;
    border: 0;
    background: none;
    color: var(--muted);
    font: 11px/1.4 var(--font-mono);
    cursor: pointer;
  }

  .card pre {
    margin: 0 0 var(--s-3);
    padding: var(--s-2) var(--s-3);
    overflow-x: auto;
    border: 1px solid var(--rule);
    background: var(--ground-2);
    font: 12px/1.5 var(--font-mono);
  }

  .declaration .rest {
    color: var(--muted);
  }

  /* A name's declaration beside it while the pointer rests there */
  .peek {
    position: fixed;
    z-index: 5;
    box-sizing: border-box;
    max-width: min(640px, calc(100vw - 16px));
    max-height: 50vh;
    padding: var(--s-2) var(--s-3);
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    background: var(--ground-2);
    box-shadow: 0 8px 24px hsl(220 30% 3% / 0.6);
    pointer-events: none;
  }

  .peek[hidden] {
    display: none;
  }

  .peek pre {
    margin: 0;
    color: var(--text-2);
    font: 12px/1.5 var(--font-mono);
  }

  .peek p {
    max-width: 60ch;
    margin: var(--s-2) 0 0;
    color: var(--text-2);
    font: 13px/1.5 var(--font-sans);
  }

  .peek p code {
    color: var(--text);
    font: 12px var(--font-mono);
  }

  .card p {
    max-width: 60ch;
    margin: 0 0 var(--s-3);
    font: 13px/1.5 var(--font-sans);
  }

  .card p code {
    color: var(--text);
    font: 12px var(--font-mono);
  }

  .card p.aside {
    color: var(--muted);
  }

  .card h4 {
    margin-top: var(--s-3);
  }

  .card p.names {
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .card ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card li a {
    display: block;
    padding: 2px 0;
    overflow: hidden;
    color: var(--text-2);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card li .where {
    color: var(--muted);
  }

  .card li mark {
    background: none;
    color: var(--accent-high);
  }

  @media (max-width: 900px) {
    :root {
      --line: 18px;
      --lane: 14px;
      --code-size: 12px;
    }

    /* Without a zero minimum the column widens to the card's longest line, and phones zoom out */
    .tour {
      grid-template-columns: minmax(0, 1fr);
    }

    .side {
      position: static;
      order: -1;
      min-width: 0;
      height: auto;
      border-left: 0;
    }

    /* The card opens as a sheet over the foot of the screen; lines scroll into view above it */
    .card.open {
      position: fixed;
      inset: auto 0 0;
      z-index: 4;
      max-height: 45vh;
      overflow-y: auto;
      overscroll-behavior: contain;
      border-top: 1px solid var(--rule-strong);
      border-bottom: 0;
      background: var(--ground-2);
      box-shadow: 0 -8px 24px hsl(220 30% 3% / 0.6);
    }

    .card.open pre {
      background: var(--ground);
    }

    .file .line {
      scroll-margin-bottom: 47vh;
    }

    .bar .key {
      display: none;
    }
  }
</style>
