---
// The module map: every module on a plate for its area, grouped by kind. Pointing at one draws a
// line to each module it takes and from each that takes it, dotted where the taken one also fills
// accessors in the taker's shaders, over a dithered light; the kinds above filter the plates.
import type { Kind } from '../../contracts/contract.ts';
import { loadModules } from './load.ts';
import { hrefOf, moduleById, relationsOf, type ModuleContract } from './modules.ts';
import { areasOf, places } from './nav.ts';

const modules = await loadModules();
const relations = relationsOf(modules);
const name = (id: string) => moduleById(modules, id).namespace;

// The kinds as a reader meets them: what records first, helpers after.
const order: readonly Kind[] = ['module', 'shader', 'cpu', 'platform', 'tool'];
const byName = (a: ModuleContract, b: ModuleContract) =>
  a.namespace.localeCompare(b.namespace, 'en', { sensitivity: 'base' });

const plates = areasOf(modules).map((area) => {
  const members = modules.filter((module) => places(area, module.id));
  return {
    area: area.label,
    count: members.length,
    groups: order
      .map((kind) => ({ kind, members: members.filter((m) => m.kind === kind).toSorted(byName) }))
      .filter((group) => group.members.length > 0),
  };
});
const widest = Math.max(...plates.map((plate) => plate.count));

const kindCounts = order.map((kind) => ({
  kind,
  count: modules.filter((module) => module.kind === kind).length,
}));

const related = new Set(relations.flatMap((relation) => [relation.from, relation.to]));

const summaries = Object.fromEntries(
  modules.map((module) => [
    module.id,
    {
      name: module.namespace,
      specifier: module.specifier,
      kind: module.kind,
      summary: module.summary.replaceAll('`', ''),
    },
  ]),
);
---

<figure class="map not-content" data-map data-pagefind-ignore>
  <div class="kinds" role="group" aria-label="Show one kind">
    {
      kindCounts.map(({ kind, count }) => (
        <button type="button" data-kind={kind} aria-pressed="false">
          {kind}
          <span class="no">{count}</span>
        </button>
      ))
    }
  </div>

  <div class="sheet">
    <canvas class="light" aria-hidden="true"></canvas>
    <svg class="leaders" aria-hidden="true"></svg>
    <div class="plates">
      {
        plates.map(({ area, count, groups }) => (
          <section class:list={['plate', { wide: count === widest }]} aria-label={area}>
            <header>
              <b>{area}</b>
              <span class="no">{count}</span>
            </header>
            <div class="groups">
              {groups.map(({ kind, members }) => (
                <div class:list={['group', { long: members.length > 6 }]} data-kind={kind}>
                  <h4>{kind}</h4>
                  <ul>
                    {members.map((module) => {
                      const href = hrefOf(modules, module);
                      const attrs = {
                        class: 'module',
                        'data-id': module.id,
                        'data-kind': module.kind,
                        'data-related': related.has(module.id) ? '' : undefined,
                      };
                      return (
                        <li>
                          {href ? (
                            <a href={href} {...attrs}>
                              {module.namespace}
                            </a>
                          ) : (
                            <span tabindex="0" {...attrs}>
                              {module.namespace}
                            </span>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <div class="readout" aria-live="polite">
    <p class="head"><code data-name></code><span data-meta></span></p>
    <p data-text>
      Point at a module to see the modules it takes and the modules that take it. A dotted line
      means the taken module also fills accessors in the taker's shaders.
    </p>
    <p class="links" data-links></p>
  </div>

  <figcaption class="sr-only">
    <ul>
      {
        relations.map((relation) => (
          <li>
            {name(relation.from)} takes {name(relation.to)}
            {relation.fills && `, which fills accessors in its shaders`}
          </li>
        ))
      }
    </ul>
  </figcaption>

  <script
    is:inline
    type="application/json"
    data-relations
    set:html={JSON.stringify({ relations, summaries })}
  />
</figure>

<script>
  import { paint, rampOf } from './dither.ts';

  interface Relation {
    from: string;
    to: string;
    fills: boolean;
  }

  interface Summary {
    name: string;
    specifier: string;
    kind: string;
    summary: string;
  }

  const SVG = 'http://www.w3.org/2000/svg';
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  for (const map of document.querySelectorAll<HTMLElement>('[data-map]')) {
    const { relations, summaries } = JSON.parse(
      map.querySelector('[data-relations]')?.textContent ?? '{}',
    ) as { relations: Relation[]; summaries: Record<string, Summary> };
    const sheet = map.querySelector<HTMLElement>('.sheet')!;
    const light = map.querySelector<HTMLCanvasElement>('canvas.light')!;
    const leaders = map.querySelector<SVGSVGElement>('svg.leaders')!;
    const name = map.querySelector<HTMLElement>('[data-name]')!;
    const meta = map.querySelector<HTMLElement>('[data-meta]')!;
    const text = map.querySelector<HTMLElement>('[data-text]')!;
    const links = map.querySelector<HTMLElement>('[data-links]')!;
    const rest = text.textContent;
    const nodes = new Map(
      [...map.querySelectorAll<HTMLElement>('.module')].map((node) => [node.dataset.id!, node]),
    );
    const ramp = rampOf(light);

    let lit: string | undefined;
    let pending = 0;

    /** Where a module's label sits in the sheet, in CSS pixels. */
    const boxOf = (id: string) => {
      const node = nodes.get(id)!.getBoundingClientRect();
      const origin = sheet.getBoundingClientRect();
      return {
        left: node.left - origin.left,
        right: node.right - origin.left,
        y: node.top - origin.top + node.height / 2,
        x: node.left - origin.left + node.width / 2,
      };
    };

    /** A line from the taker to the module it takes, leaving and arriving level. */
    const lineOf = (from: string, to: string) => {
      const a = boxOf(from);
      const b = boxOf(to);
      // In one column the line bows out to the right of both; otherwise it runs between them.
      const column = Math.abs(a.left - b.left) < 8;
      const rightward = b.x >= a.x;
      const x0 = column || rightward ? a.right + 12 : a.left - 4;
      const x1 = column || !rightward ? b.right + 14 : b.left - 6;
      const bow = Math.max(a.right, b.right) + 22 + Math.abs(b.y - a.y) * 0.25;
      const c0 = column ? bow : (x0 + x1) / 2;
      const c1 = column ? bow : (x0 + x1) / 2;
      return {
        d: `M${x0},${a.y} C${c0},${a.y} ${c1},${b.y} ${x1},${b.y}`,
        start: [x0, a.y] as const,
        end: [x1, b.y] as const,
      };
    };

    const draw = (id: string | undefined) => {
      const box = sheet.getBoundingClientRect();
      leaders.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
      leaders.replaceChildren();

      const touching = id ? relations.filter((r) => r.from === id || r.to === id) : [];
      const on = new Set(id ? [id, ...touching.flatMap((r) => [r.from, r.to])] : []);
      map.classList.toggle('lit', on.size > 0);
      for (const [each, node] of nodes) {
        node.classList.toggle('on', on.has(each));
        node.classList.toggle('here', each === id);
      }

      for (const relation of touching) {
        const { d, start, end } = lineOf(relation.from, relation.to);
        const path = document.createElementNS(SVG, 'path');
        path.setAttribute('d', d);
        if (relation.fills) path.classList.add('fills');
        const tail = document.createElementNS(SVG, 'circle');
        tail.setAttribute('cx', `${start[0]}`);
        tail.setAttribute('cy', `${start[1]}`);
        tail.setAttribute('r', '1.5');
        const head = document.createElementNS(SVG, 'circle');
        head.setAttribute('cx', `${end[0]}`);
        head.setAttribute('cy', `${end[1]}`);
        head.setAttribute('r', '2.5');
        head.classList.add('head');
        leaders.append(path, tail, head);
      }

      // A pool of light under the pointed module, and a fainter one under each it touches.
      const { width, height } = box;
      if (on.size === 0) {
        light.getContext('2d')?.clearRect(0, 0, light.width, light.height);
      } else {
        const pools = [...on].map((each) => {
          const { left, right, y } = boxOf(each);
          return { x: (left + right) / 2, y, strength: each === id ? 0.42 : 0.24 };
        });
        paint(
          light,
          (u, v) => {
            let sum = 0;
            for (const pool of pools) {
              const dx = (u * width - pool.x) / 90;
              const dy = (v * height - pool.y) / 34;
              sum += pool.strength * Math.exp(-(dx * dx + dy * dy));
            }
            return sum;
          },
          { cell: 2, ramp },
        );
      }

      const summary = id ? summaries[id] : undefined;
      name.textContent = summary?.name ?? '';
      meta.textContent = summary ? `${summary.specifier} · ${summary.kind}` : '';
      links.replaceChildren();
      if (!summary || !id) {
        text.textContent = rest;
        return;
      }
      text.textContent = summary.summary;
      const list = (label: string, names: string[]) => {
        if (names.length === 0) return;
        const row = document.createElement('span');
        const head = document.createElement('i');
        head.textContent = label;
        row.append(head, names.join(', '));
        links.append(row);
      };
      list('takes', relations.filter((r) => r.from === id).map((r) => summaries[r.to].name));
      list('taken by', relations.filter((r) => r.to === id).map((r) => summaries[r.from].name));
    };

    // The lit module changes after a short dwell, so a pointer crossing the gaps doesn't flicker.
    const point = (id: string | undefined, dwell: number) => {
      clearTimeout(pending);
      if (id === lit) return;
      pending = window.setTimeout(
        () => {
          lit = id;
          draw(id);
        },
        still.matches ? 0 : dwell,
      );
    };

    for (const [id, node] of nodes) {
      node.addEventListener('pointerenter', () => point(id, 40));
      node.addEventListener('focus', () => point(id, 0));
      node.addEventListener('blur', () => point(undefined, 0));
    }
    sheet.addEventListener('pointerleave', () => point(undefined, 160));
    sheet.addEventListener('pointerover', (event) => {
      if (!(event.target as Element).closest('.module')) point(undefined, 220);
    });

    new ResizeObserver(() => {
      if (lit) draw(lit);
    }).observe(sheet);

    for (const button of map.querySelectorAll<HTMLButtonElement>('.kinds button')) {
      button.addEventListener('click', () => {
        const kind = button.dataset.kind!;
        const pressed = map.dataset.kind !== kind;
        if (pressed) map.dataset.kind = kind;
        else delete map.dataset.kind;
        for (const each of map.querySelectorAll<HTMLButtonElement>('.kinds button')) {
          each.setAttribute('aria-pressed', `${pressed && each === button}`);
        }
      });
    }
  }
</script>

<style>
  .map {
    margin: var(--s-5) 0 0;
    font-family: var(--font-mono);
  }

  .no {
    padding: 0 4px;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    color: var(--muted);
    font: 500 11px/1.4 var(--font-mono);
  }

  .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-bottom: var(--s-4);
  }

  .kinds button {
    display: inline-flex;
    gap: var(--s-2);
    align-items: center;
    padding: 3px 6px 3px 8px;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    background: none;
    color: var(--text-2);
    font: 12px/1.4 var(--font-mono);
    cursor: pointer;
    transition:
      border-color 0.12s,
      color 0.12s;
  }

  .kinds button:hover,
  .kinds button:focus-visible {
    border-color: var(--muted);
    color: var(--text);
    outline: none;
  }

  .kinds button[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent-high);
  }

  .kinds button[aria-pressed='true'] .no {
    border-color: var(--accent);
    color: var(--accent-high);
  }

  .sheet {
    position: relative;
  }

  .light,
  .leaders {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .light {
    image-rendering: pixelated;
  }

  .leaders {
    overflow: visible;
  }

  .leaders :global(path) {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .leaders :global(path.fills) {
    stroke-dasharray: 1 3;
    stroke-linecap: round;
    stroke-width: 1.5;
  }

  .leaders :global(circle) {
    fill: var(--accent);
  }

  .leaders :global(circle.head) {
    fill: var(--accent-high);
  }

  .plates {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
    gap: var(--s-3);
  }

  .plate {
    min-width: 0;
    padding: var(--s-3) var(--s-3) var(--s-2);
    border: 1px solid var(--rule);
    border-radius: 2px;
  }

  .plate.wide {
    grid-column: 1 / -1;
  }

  header {
    display: flex;
    gap: var(--s-2);
    align-items: baseline;
    margin-bottom: var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--rule);
  }

  header b {
    min-width: 0;
    hyphens: manual;
    color: var(--text);
    font: 500 13px/1.4 var(--font-mono);
  }

  header .no {
    margin-left: auto;
  }

  .groups {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-5);
  }

  .group {
    flex: 1 1 9rem;
    min-width: 0;
  }

  .group.long {
    flex: 3 1 24rem;
  }

  h4 {
    margin: 0 0 var(--s-1);
    color: var(--muted);
    font: 400 10.5px/1.6 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .long ul {
    columns: 9rem;
    column-gap: var(--s-5);
  }

  li {
    margin: 0;
    break-inside: avoid;
  }

  .module {
    position: relative;
    display: inline-block;
    padding: 1px 0 1px 8px;
    border-left: 2px solid transparent;
    color: var(--text-2);
    font: 13px/1.6 var(--font-mono);
    text-decoration: none;
    /* A halo in the ground's colour, so a leader passing under a name doesn't cut its letters */
    text-shadow:
      0 0 2px var(--ground),
      0 0 3px var(--ground),
      0 0 4px var(--ground),
      0 0 4px var(--ground);
    transition:
      color 0.12s,
      border-color 0.12s,
      opacity 0.2s;
  }

  .module:hover,
  .module:focus-visible {
    color: var(--text);
    outline: none;
  }

  .map:global(.lit) .module:not(:global(.on)) {
    opacity: 0.55;
  }

  .module:global(.on) {
    color: var(--text);
  }

  .module:global(.here) {
    border-left-color: var(--accent);
    color: var(--accent-high);
  }

  .map[data-kind] .module {
    opacity: 0.45;
  }

  .map[data-kind='module'] .module[data-kind='module'],
  .map[data-kind='shader'] .module[data-kind='shader'],
  .map[data-kind='cpu'] .module[data-kind='cpu'],
  .map[data-kind='platform'] .module[data-kind='platform'],
  .map[data-kind='tool'] .module[data-kind='tool'] {
    opacity: 1;
    color: var(--text);
  }

  .map[data-kind='module'] .group[data-kind='module'] h4,
  .map[data-kind='shader'] .group[data-kind='shader'] h4,
  .map[data-kind='cpu'] .group[data-kind='cpu'] h4,
  .map[data-kind='platform'] .group[data-kind='platform'] h4,
  .map[data-kind='tool'] .group[data-kind='tool'] h4 {
    color: var(--accent-high);
  }

  .readout {
    display: grid;
    gap: 2px;
    min-height: 5.6em;
    margin: var(--s-4) 0 0;
    padding: var(--s-3) var(--s-3) var(--s-3);
    border-top: 1px solid var(--rule);
    border-left: 2px solid var(--rule);
    background: var(--ground);
    color: var(--muted);
    font: 12.5px/1.6 var(--font-mono);
  }

  .readout p {
    margin: 0;
  }

  .readout .head {
    display: flex;
    gap: var(--s-3);
    align-items: baseline;
  }

  .readout .head:has(code:empty) {
    display: none;
  }

  .map:global(.lit) [data-text] {
    color: var(--text-2);
    font-family: var(--font-sans);
    font-size: 14px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-5);
  }

  .links :global(i) {
    margin-right: var(--s-2);
    color: var(--muted);
    font-style: normal;
  }

  .links :global(span) {
    color: var(--text);
  }

  /* While a module is lit, the readout holds to the foot of the window so it stays in view */
  .map:global(.lit) .readout {
    position: sticky;
    bottom: 0;
    z-index: 1;
    border-left-color: var(--accent);
  }

  .readout code {
    color: var(--accent-high);
    font-size: 13px;
  }

  .readout code:empty {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .module,
    .kinds button {
      transition: none;
    }
  }
</style>
