---
// The browser's colour, the home-screen icon, the link card and the page's Markdown, for Starlight's
// pages (Head.astro) and the examples' own. Starlight writes the card's title, description and
// address; other pages pass them.
import { BASE } from './urls.ts';

interface Props {
  readonly title?: string;
  readonly description?: string;
  /** The page's address from the site's root, without the query a profiling mode adds. */
  readonly canonical?: string;
  /** The page's Markdown for agents, from the site's root, such as `markdownHref('kit/frames')`. */
  readonly markdown?: string | undefined;
}

const { title, description, canonical, markdown } = Astro.props;
// Crawlers want full addresses, which a build knows from `site`
const card = `${BASE}social.png`;
const cardHref = Astro.site ? new URL(card, Astro.site).href : card;
const address = canonical && Astro.site ? new URL(canonical, Astro.site).href : undefined;
---

<meta name="theme-color" content="#0a0d12" />
<link rel="apple-touch-icon" href={`${BASE}apple-touch-icon.png`} />
<meta property="og:image" content={cardHref} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="TypeGPU Kit" />
{markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
{
  title && (
    <>
      <meta property="og:title" content={title} />
      <meta name="twitter:card" content="summary_large_image" />
    </>
  )
}
{
  description && (
    <>
      <meta name="description" content={description} />
      <meta property="og:description" content={description} />
    </>
  )
}
{
  address && (
    <>
      <link rel="canonical" href={address} />
      <meta property="og:url" content={address} />
    </>
  )
}
