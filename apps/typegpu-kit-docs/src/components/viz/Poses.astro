---
import Choice from './Choice.astro';
import { CLIP_KEYS, FADE, SPEED, START } from './Poses.scene.ts';
import Slider from './Slider.astro';
---

<figure class="viz" data-viz="poses">
  <p class="viz-title">One animation pose moves two characters</p>
  <canvas aria-label="Minion and rogue skeletons with swords sharing one animation pose"></canvas>
  <div class="viz-controls" data-pagefind-ignore>
    <button data-action="play" aria-pressed="true">Pause</button>
    <Choice name="clip" label="clip" options={CLIP_KEYS} value={START.clip} />
    <Slider name="fade" min={FADE.min} max={FADE.max} step={FADE.step} value={START.fade} unit=" s" />
    <Slider name="speed" min={SPEED.min} max={SPEED.max} step={SPEED.step} value={START.speed} unit="×" />
  </div>
  <figcaption class="viz-caption">
    <b class="viz-try">Try</b> Change the clip, fade or speed; a negative speed plays backward. One pose moves both characters through <code>rebind</code>, with the same sword model attached to each right hand.
  </figcaption>
</figure>

<style>
  canvas {
    cursor: grab;
    touch-action: pan-y;
  }
</style>

<script>
  import { action, choice, each, live, slider } from './figure.ts';
  import type { Clip } from './Poses.scene.ts';

  each('poses', (figure) => {
    const fade = slider(figure, 'fade', undefined, (value) => value.toFixed(2));
    let picked = false;
    const clip = choice<Clip>(figure, 'clip', (chosen) => {
      picked = true;
      shown.update((scene) => scene.play(chosen, fade.valueAsNumber));
    });
    const speed = slider(
      figure,
      'speed',
      (value) => {
        shown.update((scene) => scene.speed(value));
      },
      (value) => value.toFixed(1),
    );

    const shown = live(figure, () => import('./Poses.scene.ts'), undefined, {
      animate: true,
      grade: 1,
      play: action(figure, 'play'),
      loading: 'Loading the models, 1.6 MB.',
      orbit: true,
      ready(scene) {
        if (picked) scene.play(clip.value, 0);
        scene.speed(speed.valueAsNumber);
      },
    });
  });
</script>
