---
import Slider from './Slider.astro';
---

<figure class="viz" data-viz="recording-log">
  <p class="viz-title">A recording root's counters and command log</p>
  <svg viewBox="0 0 480 124" role="img" aria-label="Recording-root counters and command log"></svg>
  <div class="viz-controls" data-pagefind-ignore>
    <button data-action="init">initAsync()</button>
    <button data-action="frame">frame</button>
    <Slider inline name="steps" min={0} max={3} value={2} />
    <button data-action="reset">Reset</button>
  </div>
  <details class="viz-wgsl" data-pagefind-ignore>
    <summary>WGSL in <code>log.shaders</code></summary>
    <label>module <select data-control="shader" autocomplete="off"></select></label>
    <pre><code></code></pre>
  </details>
  <figcaption class="viz-caption">
    <b class="viz-try">Try</b> Press frame again to see that a steady frame allocates nothing, with changed counters highlighted. Reset and run a frame before <code>initAsync()</code> to see compilation on first use. <em>steps</em> sets how many fixed steps a frame records.
  </figcaption>
</figure>

<style>
  .viz-wgsl {
    margin-top: var(--s-3);
  }
  .viz-wgsl label {
    display: flex;
    gap: var(--s-2);
    align-items: center;
    margin-block: var(--s-2);
    color: var(--text-2);
    font-size: var(--type-small);
  }
  .viz-wgsl select {
    min-width: 0;
    max-width: 100%;
    height: 30px;
    padding: 0 var(--s-2);
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
    background: var(--ground);
    color: var(--text);
    font: var(--type-label) var(--font-mono);
  }
  .viz-wgsl pre {
    max-height: 18rem;
    overflow: auto;
    padding: var(--s-3);
    border: 0;
    border-left: 2px solid var(--rule);
    background: none;
    font: var(--type-status) / 1.5 var(--font-mono);
  }
</style>

<script>
  import { action, control, each, slider, whenNear } from './figure.ts';
  import { COUNTERS, createProgram, type Counter } from './RecordingLog.program.ts';
  import { stipple, CHAR, fitWidth, svg, text } from './svg.ts';

  each('recording-log', (root) => {
    const figure = root.querySelector('svg')!;
    const stepsInput = slider(root, 'steps');
    const shaderSelect = control<HTMLSelectElement>(root, 'shader');
    const code = root.querySelector('pre code')!;

    let program = createProgram();
    let before = new Map<Counter, number>();
    let from = 0; // first event of the last action
    let last = 'nothing yet';

    const showShaders = () => {
      const { shaders } = program.log;
      const chosen = Math.min(Number(shaderSelect.value || 0), Math.max(shaders.length - 1, 0));

      shaderSelect.replaceChildren(
        ...shaders.map((wgsl, i) => {
          const entries = [...wgsl.matchAll(/@(?:compute|vertex|fragment)\b[^{]*?\bfn\s+(\w+)/g)].map((match) => match[1]);
          const option = new Option(`${entries.join(', ')}: ${wgsl.split('\n').length} lines`, String(i));
          option.selected = i === chosen;
          return option;
        }),
      );

      code.textContent = shaders[chosen] ?? 'Nothing compiled yet.';
    };

    const draw = fitWidth(figure, (width) => {
      const columns = width < 520 ? 4 : COUNTERS.length;
      const cell = width / columns;
      COUNTERS.forEach((name, i) => {
        const value = program.count(name);
        const changed = value !== (before.get(name) ?? 0);
        const cx = (i % columns) * cell;
        const cy = Math.floor(i / columns) * 48;

        text(figure, cx, cy + 12, name);
        text(figure, cx, cy + 38, String(value), {
          class: changed ? '' : 'strong',
          style: `font-size: 22px;${changed ? ' fill: var(--viz-accent)' : ''}`,
        });
      });

      let y = Math.ceil(COUNTERS.length / columns) * 48 + 22;
      text(figure, 0, y, `log.events of ${last}`, { class: 'strong' });
      y += 12;

      const events = program.log.events.slice(from);
      let x = 0;
      let pass: { x: number; label: string } | undefined;

      const box = () => {
        if (!pass) return;
        x = Math.max(x, pass.x + pass.label.length * CHAR + 10);
        svg('rect', { x: pass.x, y, width: x - pass.x + 2, height: 34, rx: 2, fill: 'none', stroke: 'var(--viz-line)' }, figure);
        text(figure, pass.x + 6, y + 10, pass.label);
      };

      const fit = (needed: number) => {
        if (x + needed <= width || x === 0) return;
        box();
        x = 0;
        y += 42;
        if (pass) {
          pass = { x: 0, label: `${pass.label}, continued` };
          x = 6;
        }
      };

      if (events.length === 0) text(figure, 0, y + 18, 'nothing recorded');

      for (const event of events) {
        if (event.startsWith('begin-')) {
          fit(60);
          pass = { x, label: event.slice(6) };
          x += 6;
          continue;
        }

        if (event.startsWith('end-')) {
          box();
          pass = undefined;
          x += 10;
          continue;
        }

        const chip = event.length * CHAR + 12;
        fit(chip + (pass ? 8 : 0));
        const submit = event === 'submit';
        const color = submit ? 'var(--viz-e)' : event.startsWith('dispatch') ? 'var(--viz-b)' : event.startsWith('draw') || event === 'write' ? 'var(--viz-c)' : event.startsWith('copy') ? 'var(--viz-d)' : 'var(--viz-line)';
        svg('rect', {
          x, y: y + 14, width: chip, height: 16, rx: 2,
          fill: stipple(figure, color, 0.25),
          'fill-opacity': submit ? 0.3 : 1,
          stroke: submit ? color : 'none',
        }, figure);
        text(figure, x + 6, y + 26, event, { class: 'strong' });
        x += chip + 4;
      }

      return y + 42;
    });

    /** Draws the counters and events, and lists the WGSL. */
    const show = () => {
      draw();
      showShaders();
    };

    const act = (name: string, run: () => void | Promise<void>) => async () => {
      before = new Map(COUNTERS.map((counter) => [counter, program.count(counter)]));
      from = program.log.events.length;
      last = name;

      await run();
      show();
    };

    const frame = act('one frame', () => program.frame(stepsInput.valueAsNumber));
    action(root, 'init', act('initAsync()', () => program.initAsync()));
    action(root, 'frame', frame);

    action(root, 'reset', () => {
      program.destroy();
      program = createProgram();
      before = new Map();
      from = 0;
      last = 'nothing yet';
      show();
    });

    shaderSelect.addEventListener('change', showShaders);
    show();

    whenNear(root, async () => {
      await program.initAsync();
      await frame();
    });
  });
</script>
