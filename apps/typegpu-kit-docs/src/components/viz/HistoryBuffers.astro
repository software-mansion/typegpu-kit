---
import Choice from './Choice.astro';
---

<figure class="viz" data-viz="history-buffers">
  <p class="viz-title">The same moving dot, written through a history and straight into current</p>
  <svg viewBox="0 0 640 190" role="img" aria-label="Two stages with the same moving dot. Written through the history, last frame's ghost trails the dot and an arrow joins them. Written straight into current, the ghost sits under the dot and the arrow is lost."></svg>
  <p class="viz-status" aria-live="polite"></p>
  <div class="viz-controls" data-pagefind-ignore>
    <button data-action="play" aria-pressed="true">Pause</button>
    <Choice name="writes" label="write" options={['each frame', 'on click']} value="each frame" />
    <button data-action="write" disabled>Write once</button>
  </div>
  <figcaption class="viz-caption">
    <b class="viz-try">Try</b> Choose write on click, then write once. The history shows the move for one frame, until the next <code>record</code> copies the new position aside. Written straight into <code>current</code>, the position reaches <code>previous</code> in the same frame, so the move never shows.
  </figcaption>
</figure>

<style>
  @media (max-width: 40rem) {
    .viz-status {
      --lines: 2;
    }
  }
</style>

<script>
  import { smooth } from '../home/geometry.ts';
  import { action, animation, choice, each, statusLine } from './figure.ts';
  import { at, createProgram, LOOP, moved, NOTCHES, STAGE, type Point, type State, type Writes } from './HistoryBuffers.program.ts';
  import { fitWidth, stipple, svg, text } from './svg.ts';

  /** Seconds a frame stays up, and how long its marks take to reach their places. */
  const FRAME = 0.6;
  const GLIDE = 0.22;
  const GAP = 24;
  const HEAD = 20;
  const GHOST = 9;
  const DOT = 5.5;
  /** Half the readout's width. */
  const READ = 66;

  const CURRENT = 'var(--viz-c)';
  const PREVIOUS = 'var(--viz-b)';
  const MOVED = 'var(--viz-d)';
  const LOST = 'var(--viz-bad)';

  const mix = (from: Point, to: Point, k: number): Point => [from[0] + (to[0] - from[0]) * k, from[1] + (to[1] - from[1]) * k];
  const said = (point: Point) => point.join(', ');

  each('history-buffers', (root) => {
    const figure = root.querySelector('svg')!;
    const status = statusLine(root);
    const program = createProgram();
    let now = program.step();
    let before = now;
    const advance = () => {
      before = now;
      now = program.step();
    };
    // Opens with the dot crossing the top of its loop
    for (let i = 0; i < 3; i++) advance();
    let since = GLIDE;

    /** An arrow from the ghost's edge at `from` to the dot's at `to`, or its dashed trace when lost. Draws nothing, and says so, when they are too close for one. */
    const link = (from: Point, to: Point, lost = false) => {
      const length = Math.hypot(to[0] - from[0], to[1] - from[1]);
      if (length < GHOST + DOT + 9) return false;
      const ux = (to[0] - from[0]) / length;
      const uy = (to[1] - from[1]) / length;
      const tip = [to[0] - ux * (DOT + 3), to[1] - uy * (DOT + 3)];
      const neck = [tip[0] - ux * 6, tip[1] - uy * 6];
      const color = lost ? LOST : MOVED;
      svg(
        'line',
        {
          x1: from[0] + ux * GHOST,
          y1: from[1] + uy * GHOST,
          x2: lost ? tip[0] : neck[0],
          y2: lost ? tip[1] : neck[1],
          stroke: color,
          'stroke-width': 1.5,
          ...(lost ? { 'stroke-dasharray': '2 4' } : {}),
        },
        figure,
      );
      if (!lost) svg('path', { d: `M${tip[0]},${tip[1]}L${neck[0] - uy * 3.5},${neck[1] + ux * 3.5}L${neck[0] + uy * 3.5},${neck[1] - ux * 3.5}Z`, fill: color }, figure);
      return true;
    };

    const ghost = ([cx, cy]: Point, r = GHOST) => svg('circle', { cx, cy, r, fill: stipple(figure, PREVIOUS, 0.5), stroke: PREVIOUS }, figure);
    const dot = ([cx, cy]: Point, r = DOT) => svg('circle', { cx, cy, r, fill: CURRENT, stroke: 'var(--ground)', 'stroke-width': 1.5 }, figure);

    const draw = fitWidth(figure, (width) => {
      const wide = width >= 560;
      const w = wide ? (width - GAP) / 2 : width;
      const scale = w / STAGE.width;
      const height = STAGE.height * scale;
      const k = timeline.playing ? smooth(since / GLIDE) : 1;
      const shown = (side: 'kept' | 'straight'): State => ({
        current: mix(before[side].current, now[side].current, k),
        previous: mix(before[side].previous, now[side].previous, k),
      });

      /** One stage: `drawn` places its marks, `held` is what its buffers hold, `owed` the previous position it lost. */
      const stage = (left: number, top: number, title: string, drawn: State, held: State, owed?: Point) => {
        const place = ([x, y]: Point): Point => [left + x * scale, top + HEAD + y * scale];
        text(figure, left, top + 11, title, { class: 'strong' });
        svg('rect', { x: left + 0.5, y: top + HEAD + 0.5, width: w - 1, height: height - 1, rx: 2, fill: 'none', stroke: 'var(--viz-line)' }, figure);
        const centre = place([LOOP.x, LOOP.y]);
        svg('ellipse', { cx: centre[0], cy: centre[1], rx: LOOP.rx * scale, ry: LOOP.ry * scale, fill: 'none', stroke: 'var(--rule)' }, figure);
        for (let notch = 0; notch < NOTCHES; notch++) {
          const [cx, cy] = place(at(notch));
          svg('circle', { cx, cy, r: 1.5, fill: 'var(--viz-muted)' }, figure);
        }

        const here = place(drawn.current);
        const there = place(drawn.previous);
        if (owed) {
          const [cx, cy] = place(owed);
          if (link([cx, cy], here, true)) svg('circle', { cx, cy, r: GHOST, fill: 'none', stroke: LOST, 'stroke-dasharray': '2 3' }, figure);
        }
        link(there, here);
        ghost(there);
        dot(here);

        // What the buffers hold, inside the loop
        const row = (i: number, name: string, value: string, color: string, mark: (spot: Point) => void, tinted = false) => {
          const line = centre[1] + (i - 1) * 17;
          mark([centre[0] - READ + 5, line]);
          text(figure, centre[0] - READ + 18, line + 4, name, { fill: color });
          text(figure, centre[0] + READ, line + 4, value, { 'text-anchor': 'end', ...(tinted ? { fill: color } : { class: 'strong' }) });
        };
        row(0, 'current', said(held.current), CURRENT, (spot) => dot(spot, 4));
        row(1, 'previous', said(held.previous), PREVIOUS, (spot) => ghost(spot, 4.5));
        // Coral where the history saw a move these buffers lost, grey where nothing moved
        const missing = moved(now.kept) > moved(held);
        const tone = missing ? LOST : moved(held) > 0 ? MOVED : 'var(--viz-muted)';
        const arrow = ([cx, cy]: Point) => {
          svg('line', { x1: cx - 5, y1: cy, x2: cx + 1, y2: cy, stroke: tone, 'stroke-width': 1.5, ...(missing ? { 'stroke-dasharray': '2 2' } : {}) }, figure);
          if (!missing) svg('path', { d: `M${cx + 6},${cy}l-6,-3.5v7Z`, fill: tone }, figure);
        };
        row(2, 'moved', String(Math.round(moved(held))), tone, arrow, true);
      };

      const kept = shown('kept');
      stage(0, 0, 'placed.write(next)', kept, now.kept);
      stage(wide ? w + GAP : 0, wide ? 0 : HEAD + height + 18, 'placed.current.write(next)', shown('straight'), now.straight, kept.previous);

      status.textContent = now.written
        ? `Frame ${now.index} wrote ${said(now.written)}. Only the history copied ${said(now.kept.previous)} aside first.`
        : `Frame ${now.index} wrote nothing, so both copied ${said(now.kept.current)} into previous.`;

      return (wide ? 1 : 2) * (HEAD + height) + (wide ? 0 : 18) + 1;
    });

    const play = action(root, 'play');
    const timeline = animation(root, {
      step(dt) {
        since += dt;
        if (since < FRAME) return;
        advance();
        since = 0;
      },
      draw,
      play,
      destroy: () => program.destroy(),
    });
    // A paused picture rests on its frame
    play.addEventListener('click', () => timeline.redraw());

    const write = action(root, 'write', () => {
      program.write();
      if (timeline.playing) {
        since = FRAME;
        return;
      }
      advance();
      timeline.redraw();
    });

    choice<Writes>(root, 'writes', (writes) => {
      program.writes = writes;
      write.disabled = writes === 'each frame';
    });
  });
</script>
