---
// A box or a foil pack resting on the page, the way into a pull: pressing it opens it over the page
// and pulls a card for the album out of it. A hidden one holds the `card` it names; any other is the
// first one, which holds a random common card.

interface Props {
  vessel: 'box' | 'pack';
  /** The example a hidden vessel holds. */
  card?: string;
  /** The pack's lean on the page, in radians. */
  lean?: number;
  class?: string;
}

const { vessel, card, lean, class: extra } = Astro.props;
---

<button
  type="button"
  class:list={['pull-object not-content', extra]}
  data-pull-object={vessel}
  data-card={card}
  data-lean={lean}
  aria-label={`${vessel === 'box' ? 'Open a sealed box' : 'Tear open a sealed pack'}, which holds a card for your album`}
  aria-haspopup="dialog"
>
  <canvas aria-hidden="true"></canvas>
</button>

<script>
  import { whenCards } from '../album/cards.ts';

  whenCards(() => void import('./resting.ts').then(({ mountResting }) => mountResting()));
</script>

<style>
  .pull-object {
    position: relative;
    display: block;
    flex: none;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .pull-object:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 2px;
  }

  /* It shows once WebGPU has compiled it, and never without */
  .pull-object:not([data-gpu]) {
    visibility: hidden;
  }

  .pull-object[hidden],
  :global(:root:not([data-cards])) .pull-object {
    display: none;
  }

  /* While the overlay holds it */
  .pull-object[data-away] canvas {
    visibility: hidden;
  }
</style>

<style is:global>
  /* The overlay's shell, buttons and row are in card.css */
  dialog.pull {
    color: var(--text);
  }

  /* The vessel from the page is drawn over its place at once; only the page dims under it */
  dialog.pull[open]::backdrop {
    animation: pull-in 0.32s ease both;
  }

  @keyframes pull-in {
    from {
      opacity: 0;
    }
  }

  .pull-stage {
    perspective: 1400px;
  }

  .pull-object canvas,
  .pull-vessel {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: none;
    opacity: 0;
    image-rendering: pixelated;
    transition: opacity 0.5s ease;
  }

  .pull-object[data-gpu] canvas,
  dialog.pull[data-gpu] .pull-vessel {
    opacity: 1;
  }

  /* The waiting pack tears under a drag, so the stage takes the pointer's moves itself */
  dialog.pull[data-waiting] .pull-stage {
    cursor: grab;
    touch-action: none;
  }

  dialog.pull[data-waiting] .pull-stage:active {
    cursor: grabbing;
  }

  .pull-hint {
    position: absolute;
    left: 50%;
    margin: 0;
    color: var(--muted);
    font: 500 var(--type-label) / 1.4 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    translate: -50% 0;
    pointer-events: none;
  }

  .pull-row {
    width: max-content;
    max-width: calc(100% - 48px);
    white-space: nowrap;
  }

  .pull-note {
    display: grid;
    max-width: min(34rem, calc(100vw - 48px));
    margin: 0;
    color: var(--muted);
    font: 400 var(--type-small) / 1.5 var(--font-sans);
    text-align: center;
    white-space: normal;
  }

  /* The first card's welcome comes before the button, its first line a lead */
  .pull-note[data-first] {
    order: -1;
    gap: var(--s-1);
  }

  .pull-note[data-first] > :first-child {
    color: var(--text);
    font-size: var(--type-body);
    font-weight: 500;
  }

  .pull-off {
    padding: 0;
    border: 0;
    background: none;
    color: var(--link);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .pull-primary:hover {
    color: var(--accent-high);
  }

  .pull-close {
    position: absolute;
    top: var(--s-4);
    right: var(--s-4);
  }

  .pull-close:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .pull-close svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }
</style>
